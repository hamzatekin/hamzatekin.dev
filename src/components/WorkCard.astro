---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

export interface WorkLink {
  href: string;
  label: string;
  icon: IconName;
}

interface Props {
  title: string;
  badge: string;
  description: string;
  /** Makes the whole card one link, with the arrow affordance. */
  href?: string;
  /** Links only the title — for cards that hold their own links. */
  titleHref?: string;
  links?: WorkLink[];
}

const { title, badge, description, href, titleHref, links = [] } = Astro.props;

// The whole card is a link when `href` is set; otherwise nothing is wrapped.
const Wrapper = href ? 'a' : Fragment;
const wrapperProps = href ? { href, target: '_blank', rel: 'noopener noreferrer', class: 'block no-underline' } : {};
---

<article
  class:list={[
    'group rounded-lg border border-border bg-card p-5 transition-[background-color,border-color,scale] duration-200 ease-out hover:border-accent-foreground/30 hover:bg-accent/50',
    // Only a card that is itself a link gets press feedback; a large surface wants a subtler scale than a button.
    href && 'motion-safe:active:scale-[0.99]',
  ]}
>
  <Wrapper {...wrapperProps}>
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        <div class="mb-2 flex items-center gap-3">
          <h3 class="text-lg font-semibold text-foreground">
            {
              titleHref ? (
                <a
                  href={titleHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="no-underline decoration-muted-foreground underline-offset-4 hover:underline"
                >
                  {title}
                </a>
              ) : (
                title
              )
            }
          </h3>
          <span
            class="rounded-full border border-border bg-muted px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-muted-foreground"
          >
            {badge}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>
        {
          links.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="tap-target inline-flex items-center gap-1.5 rounded-md border border-border bg-background/60 px-2.5 py-1 text-xs font-medium transition-[background-color,scale] duration-150 ease-out hover:bg-accent motion-safe:active:scale-[0.97]"
                >
                  <Icon name={link.icon} class="h-3 w-3" />
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
      {
        href && (
          <Icon
            name="arrow-up-right"
            class="h-4 w-4 shrink-0 text-muted-foreground transition-[translate] duration-200 ease-out motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:translate-x-0.5"
          />
        )
      }
    </div>
  </Wrapper>
</article>
