---
// Cloudflare Web Analytics, rendered by Layout.astro in production only.
//
// It runs under PECR's statistical-purposes exception (Schedule A1, paragraph 5), which requires an
// easy, free way to object. So the beacon is only fetched when the visitor hasn't objected: the
// switch on /privacy (stored under `analytics-off`), Global Privacy Control, or Do Not Track. An
// objecting browser never loads it. Automatic injection must stay off in the Cloudflare dashboard
// (Web Analytics > Manage site), otherwise Cloudflare adds the beacon to every page regardless.
// The token-in-URL form is Cloudflare's documented way to insert the beacon from a script.
---

<script is:inline>
  (() => {
    try {
      // umami.disabled: objections saved before the switch from Umami (October 2026).
      if (localStorage.getItem('analytics-off') || localStorage.getItem('umami.disabled')) return;
    } catch {}
    if (navigator.globalPrivacyControl || navigator.doNotTrack === '1') return;
    const script = document.createElement('script');
    script.type = 'module';
    script.src = 'https://static.cloudflareinsights.com/beacon.min.js?token=c4e3ff04978a407daba87468bbdad109&spa=false';
    document.body.append(script);
  })();
</script>
