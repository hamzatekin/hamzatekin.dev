---
export type IconName = 'github' | 'linkedin' | 'npm' | 'mail' | 'arrow-up-right';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;

// npm is a solid glyph; the rest are stroked line icons (lucide).
const solid: IconName[] = ['npm'];

const paths: Record<IconName, string> = {
  github: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" />`,
  linkedin: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />`,
  npm: `<path d="M0 7.334v8h6.666v1.332H5.334v1.334h6.666v-2.666H5.334v-1.334h6.666v-6.666H0zm1.334 1.334h4v5.332h-1.334v-4h-1.332v4h-1.334V8.668zm13.332-1.334v8h1.334v-6.666h1.332v6.666h1.334v-6.666h1.332v6.666H24V7.334H14.666z" />`,
  mail: `<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />`,
  'arrow-up-right': `<path d="M7 7h10v10" /><path d="M7 17 17 7" />`,
};

const strokeAttrs = solid.includes(name)
  ? { fill: 'currentColor' }
  : {
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': '2',
      'stroke-linecap': 'round' as const,
      'stroke-linejoin': 'round' as const,
    };
---

<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class={className} aria-hidden="true" {...strokeAttrs}>
  <Fragment set:html={paths[name]} />
</svg>
