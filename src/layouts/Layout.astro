---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Hamza Tekin - Software Engineer',
  description = 'Software engineer in Nottingham, UK. I build web apps and the backends behind them, mostly in TypeScript.',
  noindex = false,
} = Astro.props;

// build.format is 'file', so Astro.url.pathname is '/index.html' or '/privacy.html' at build time.
// Map that back to the clean route (trailingSlash is 'never'): '/' and '/privacy'.
const routePath =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/\/$/, '') || '/';
const canonical = new URL(routePath, Astro.site).href.replace(/\/$/, '');

const analyticsEnabled = import.meta.env.PROD && import.meta.env.SITE === 'https://hamzatekin.dev';

// The body is wrapped in <!--email_off--> markers so Cloudflare's Email Address Obfuscation leaves the
// contact address alone. Otherwise it swaps the address for "[email protected]" and injects a
// decoder script, which breaks the link without JavaScript.
---

<!doctype html>
<html lang="en-GB" class="dark">
  <head>
    <!-- Primary Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Hamza Tekin" />
    <meta name="keywords" content="software engineer, TypeScript, frontend engineering, PostgreSQL, systems design, web applications" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Hamza Tekin" />
    <meta property="og:image" content="https://hamzatekin.dev/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hamzatekin.dev/og-image.jpg" />
    <meta name="twitter:creator" content="@hamzatekin" />

    <!-- Technical SEO -->
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <meta name="robots" content="index, follow" />
          <meta name="googlebot" content="index, follow" />
          <link rel="canonical" href={canonical} />
        </>
      )
    }

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme -->
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="msapplication-TileColor" content="#0b0b0b" />

    <!-- Performance -->
    <meta name="generator" content={Astro.generator} />
    <link rel="dns-prefetch" href="//github.com" />
    <link rel="dns-prefetch" href="//www.linkedin.com" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Hamza Tekin",
        "jobTitle": "Software Engineer",
        "description": "Software engineer in Nottingham, UK, building web apps and the backends behind them",
        "url": "https://hamzatekin.dev",
        "sameAs": ["https://github.com/hamzatekin", "https://www.linkedin.com/in/hamza-tekin-5a003858/"],
        "knowsAbout": ["Software Engineering", "TypeScript", "Frontend Engineering", "PostgreSQL", "Systems Design", "Web Applications"]
      }
    </script>
  </head>
  <body>
    <!--email_off-->
    <div class="min-h-screen bg-background text-foreground">
      <div class="mx-auto max-w-[700px] px-6 py-16 md:py-24">
        <main>
          <slot />
        </main>
        <SiteFooter currentPath={routePath} />
      </div>
    </div>
    <!--/email_off-->

    {analyticsEnabled && <Analytics />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
