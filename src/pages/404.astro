---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found - Hamza Tekin" description="This page does not exist or has been moved." noindex>
  <div class="min-h-screen bg-background text-foreground">
    <main class="mx-auto max-w-[700px] px-6 py-16 md:py-24">
      <header>
        <p class="mb-3 text-sm uppercase tracking-wider text-muted-foreground">404</p>
        <h1 class="mb-4 text-3xl font-semibold tracking-tight">Page not found</h1>
        <p class="mb-10 text-base leading-relaxed text-muted-foreground">The page you are looking for does not exist or has been moved.</p>
      </header>
      <nav>
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-md border border-border bg-card px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:border-accent-foreground/20"
        >
          Back to home
        </a>
      </nav>
    </main>
  </div>
</Layout>
