---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLink from '../components/SocialLink.astro';
import WorkCard from '../components/WorkCard.astro';
import type { WorkLink } from '../components/WorkCard.astro';

const year = new Date().getFullYear();

const GITHUB_URL = 'https://github.com/hamzatekin';
const LINKEDIN_URL = 'https://www.linkedin.com/in/hamza-tekin-5a003858/';
const EMAIL = 'hello@hamzatekin.dev';

const socials = [
  { href: GITHUB_URL, icon: 'github' as const, label: 'GitHub' },
  { href: LINKEDIN_URL, icon: 'linkedin' as const, label: 'LinkedIn' },
];

// `emphasis` is the part of the line that gets the brighter foreground colour.
const currently = [
  { before: 'Working as a Frontend Engineer at ', emphasis: 'ReviewSolicitors', after: ' in Nottingham, UK' },
  { before: 'Building ', emphasis: 'Liftium', after: ' — an AI-powered strength training platform' },
  { before: 'Maintaining ', emphasis: 'Convoy', after: ' — an open-source reactive backend library for PostgreSQL' },
  { before: 'Open to selective consulting and AI / product engineering roles', emphasis: '', after: '' },
];

const work: {
  title: string;
  badge: string;
  description: string;
  href?: string;
  titleHref?: string;
  links?: WorkLink[];
}[] = [
  {
    title: 'ReviewSolicitors',
    badge: 'Full-time',
    description: 'Frontend Engineer, based in Nottingham, UK.',
    href: 'https://www.reviewsolicitors.co.uk/',
  },
  {
    title: 'Convoy',
    badge: 'Open-source',
    description: 'Convex-style reactive backend for PostgreSQL. Real-time data synchronization with type-safe queries and subscriptions.',
    titleHref: 'https://github.com/hamzatekin/convoy',
    links: [
      { href: 'https://www.npmjs.com/package/@avvos/convoy', label: 'npm', icon: 'npm' },
      { href: 'https://github.com/hamzatekin/convoy', label: 'GitHub', icon: 'github' },
    ],
  },
  {
    title: 'Liftium',
    badge: 'Product',
    description: 'AI-powered strength training platform focused on evidence-based programming.',
    href: 'https://liftium.app/',
  },
];

const principles = ['Ship + iterate', 'Proven tech, well-used', 'UX matters'];
---

<Layout>
  <div class="min-h-screen bg-background text-foreground">
    <main class="mx-auto max-w-[700px] px-6 py-16 md:py-24">
      <header id="hero" class="mb-24">
        <h1 class="mb-3 text-4xl font-semibold tracking-tight md:text-5xl">Hamza Tekin</h1>
        <p class="mb-6 text-xl text-muted-foreground md:text-2xl">AI &amp; Product Engineer</p>
        <p class="mb-6 text-base leading-relaxed text-muted-foreground md:text-lg">
          I build AI-powered products end to end, from the systems and pipelines that make them work to the interfaces people actually use.
        </p>
        <nav aria-label="Social links">
          <ul class="flex list-none flex-wrap gap-3 p-0">
            {
              socials.map((social) => (
                <li>
                  <SocialLink {...social} />
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <Divider />

      <section id="currently" class="mb-24">
        <SectionHeading>Currently</SectionHeading>
        <ul class="space-y-3">
          {
            currently.map((item) => (
              <li class="flex gap-3 text-base leading-relaxed">
                <span class="text-muted-foreground">—</span>
                <span>
                  {item.before}
                  {item.emphasis && <span class="font-medium text-foreground">{item.emphasis}</span>}
                  {item.after}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <Divider />

      <section id="work" class="mb-24">
        <SectionHeading spacing="wide">Selected work</SectionHeading>
        <div class="space-y-6">
          {work.map((item) => <WorkCard {...item} />)}
        </div>
      </section>

      <Divider />

      <section id="how" class="mb-24">
        <SectionHeading>How I work</SectionHeading>
        <p class="mb-6 text-base leading-relaxed text-foreground">
          I care deeply about clarity, long-term maintainability, and shipping things that actually get used. I communicate early and often,
          and I default to transparency. I value simple systems, strong fundamentals, and pragmatic engineering over novelty for its own
          sake. I prefer working in small, end-to-end vertical slices that deliver real value quickly.
        </p>
        <ul class="flex list-none flex-wrap gap-2 p-0">
          {
            principles.map((principle) => (
              <li>
                <span class="rounded-full border border-border bg-card px-3 py-1.5 text-xs font-medium">{principle}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <Divider />

      <section id="contact" class="mb-24">
        <SectionHeading>Contact</SectionHeading>
        <address class="mb-6 flex items-center gap-2 text-base not-italic">
          <Icon name="mail" class="h-4 w-4 text-muted-foreground" />
          <a
            href={`mailto:${EMAIL}`}
            class="text-foreground underline decoration-muted-foreground underline-offset-4 hover:decoration-foreground"
          >
            {EMAIL}
          </a>
        </address>
        <p class="mb-6 text-sm text-muted-foreground">Best way to reach me is email. I reply within 1–2 days.</p>
        <nav aria-label="Contact links">
          <ul class="flex list-none flex-wrap gap-2 p-0">
            {
              socials.map((social) => (
                <li>
                  <SocialLink {...social} size="sm" />
                </li>
              ))
            }
          </ul>
        </nav>
      </section>

      <footer class="border-t border-border pt-8 text-center text-xs text-muted-foreground">
        <p>&copy; {year} Hamza Tekin</p>
        <nav>
          <a
            href="/privacy"
            class="mt-2 inline-block underline decoration-muted-foreground underline-offset-4 transition-colors hover:decoration-foreground"
          >
            Privacy Policy
          </a>
        </nav>
      </footer>
    </main>
  </div>
</Layout>
