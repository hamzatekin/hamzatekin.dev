---
import Layout from '../layouts/Layout.astro';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLink from '../components/SocialLink.astro';
import WorkCard from '../components/WorkCard.astro';
import type { WorkLink } from '../components/WorkCard.astro';

const GITHUB_URL = 'https://github.com/hamzatekin';
const LINKEDIN_URL = 'https://www.linkedin.com/in/hamza-tekin-5a003858/';
const EMAIL = 'hello@hamzatekin.dev';

const socials = [
  { href: GITHUB_URL, icon: 'github' as const, label: 'GitHub' },
  { href: LINKEDIN_URL, icon: 'linkedin' as const, label: 'LinkedIn' },
];

// `emphasis` is the part of the line that gets the brighter foreground colour.
const currently = [
  { before: 'Working as a Software Engineer at ', emphasis: 'ReviewSolicitors', after: ' in Nottingham, UK' },
  { before: 'Building ', emphasis: 'Liftium', after: ', an AI-powered strength training app' },
  { before: 'Maintaining ', emphasis: 'Convoy', after: ', an open-source reactive backend library for PostgreSQL' },
  { before: 'Open to software engineering roles and the occasional consulting project', emphasis: '', after: '' },
];

const work: {
  title: string;
  badge: string;
  description: string;
  href?: string;
  titleHref?: string;
  links?: WorkLink[];
}[] = [
  {
    title: 'ReviewSolicitors',
    badge: 'Full-time',
    description: 'Software Engineer, based in Nottingham, UK.',
    href: 'https://www.linkedin.com/company/reviewsolicitors/',
  },
  {
    title: 'Convoy',
    badge: 'Open-source',
    description:
      'A Convex-style reactive backend for PostgreSQL. It keeps data in sync in real time, with type-safe queries and subscriptions.',
    titleHref: 'https://github.com/hamzatekin/convoy',
    links: [
      { href: 'https://www.npmjs.com/package/@avvos/convoy', label: 'npm', icon: 'npm' },
      { href: 'https://github.com/hamzatekin/convoy', label: 'GitHub', icon: 'github' },
    ],
  },
  {
    title: 'Liftium',
    badge: 'Product',
    description: 'An AI-powered strength training app with evidence-based programming.',
    href: 'https://liftium.app/',
  },
];
---

<Layout>
  <header id="hero" class="mb-24">
    <h1 class="mb-3 text-4xl font-semibold tracking-tight md:text-5xl">Hamza Tekin</h1>
    <p class="mb-6 text-xl text-muted-foreground md:text-2xl">Software Engineer</p>
    <p class="mb-6 text-base leading-relaxed text-muted-foreground md:text-lg">
      I build web apps and the backends behind them, mostly in TypeScript.
    </p>
    {/* role="list" keeps list semantics in Safari, which drops them when list-style is none. */}
    <ul role="list" class="flex list-none flex-wrap gap-3 p-0">
      {
        socials.map((social) => (
          <li>
            <SocialLink {...social} />
          </li>
        ))
      }
    </ul>
  </header>

  <Divider />

  <section id="currently" class="mb-24">
    <SectionHeading>Currently</SectionHeading>
    <ul role="list" class="space-y-3">
      {
        currently.map((item) => (
          <li class="flex gap-3 text-base leading-relaxed">
            <span class="text-muted-foreground" aria-hidden="true">
              —
            </span>
            {/* Astro renders a line break between these parts as a space, which would land before the comma in `after`. */}
            {/* prettier-ignore */}
            <span>{item.before}{item.emphasis && <span class="font-medium text-foreground">{item.emphasis}</span>}{item.after}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <Divider />

  <section id="work" class="mb-24">
    <SectionHeading spacing="wide">Selected work</SectionHeading>
    <div class="space-y-6">
      {work.map((item) => <WorkCard {...item} />)}
    </div>
  </section>

  <Divider />

  <section id="how" class="mb-24">
    <SectionHeading>How I work</SectionHeading>
    <p class="text-base leading-relaxed text-foreground">
      I like code that reads clearly and is still easy to change a year later, and I care how the interface feels to the person using it. My
      default is simple, well-known tools, learned properly. I work in small slices so changes reach users quickly, and I share progress
      early, including when something is going off track.
    </p>
  </section>

  <Divider />

  <section id="contact" class="mb-24">
    <SectionHeading>Contact</SectionHeading>
    <address class="mb-6 flex items-center gap-2 text-base not-italic">
      <Icon name="mail" class="h-4 w-4 text-muted-foreground" />
      <a
        href={`mailto:${EMAIL}`}
        class="text-foreground underline decoration-muted-foreground underline-offset-4 transition-colors hover:decoration-foreground"
      >
        {EMAIL}
      </a>
    </address>
    <p class="mb-6 text-sm text-muted-foreground">Email is the best way to reach me, and I usually reply within a day or two.</p>
    <ul role="list" class="flex list-none flex-wrap gap-2 p-0">
      {
        socials.map((social) => (
          <li>
            <SocialLink {...social} size="sm" />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
