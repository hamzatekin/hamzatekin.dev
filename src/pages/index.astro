---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="dark min-h-screen bg-slate-950 text-slate-50 flex flex-col">
    <section class="grow flex items-center justify-center container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl">
        <header>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 text-slate-50">Hamza Tekin</h1>
          <p class="text-xl sm:text-2xl text-slate-300 mb-8 font-medium">Product-minded TypeScript-first Engineer</p>
        </header>

        <div class="prose prose-invert prose-lg max-w-none mb-12">
          <p class="text-lg sm:text-xl text-slate-400 leading-relaxed">
            Product-minded typeScript-first engineer with a frontend focus. I build clean, performant web apps with a
            balance of speed, maintainability, and user-centric thinking, modern, and TypeScript-driven.
          </p>
        </div>

        <nav aria-label="Social media and professional links">
          <h2 class="sr-only">Connect with me</h2>
          <div class="flex justify-center space-x-6">
            <a
              href="https://github.com/hamzatekin"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-slate-50 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-950 rounded p-2"
              aria-label="Visit my GitHub profile (opens in new tab)"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
              <span class="sr-only">GitHub</span>
            </a>

            <a
              href="https://www.linkedin.com/in/hamza-tekin-5a003858/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-slate-50 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-950 rounded p-2"
              aria-label="Visit my LinkedIn profile (opens in new tab)"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                ></path>
              </svg>
              <span class="sr-only">LinkedIn</span>
            </a>
          </div>
        </nav>
      </div>
    </section>
  </main>
</Layout>
